<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Returning the shared instance is the purpose of a singleton accessor. -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Method name="getInstance"/>
    </Match>
    <!-- The default reaction to a termination from the registry ends the host process, so its orchestrator starts
         a fresh instance. Applications can override ArchonCallback.onTerminated to do otherwise. -->
    <Match>
        <Bug pattern="DM_EXIT"/>
        <Class name="dev.heysulo.archon.sdk.ArchonTermination"/>
    </Match>
    <!-- A primary that loses the vote against another primary must stop so only one keeps serving. Its
         orchestrator restarts it, and it rejoins as a mirror. -->
    <Match>
        <Bug pattern="DM_EXIT"/>
        <Class name="dev.heysulo.archon.registry.server.RegistryTermination"/>
    </Match>
    <!-- A portal replica that cannot register exits so its orchestrator starts a fresh one to retry. -->
    <Match>
        <Bug pattern="DM_EXIT"/>
        <Class name="dev.heysulo.archon.portal.PortalApplication"/>
        <Method name="register"/>
    </Match>
    <!-- The portal's services share one connection pool and one store by design; they are wired once at start. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Class name="dev.heysulo.archon.portal.auth.AuthService"/>
            <Class name="dev.heysulo.archon.portal.auth.AuthStore"/>
        </Or>
        <Method name="&lt;init&gt;"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="dev.heysulo.archon.portal.db.PortalDatabase"/>
        <Method name="dataSource"/>
    </Match>
    <!-- Sharing the pool is the point -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="dev.heysulo.archon.config.ConfigDatabase"/>
        <Method name="dataSource"/>
    </Match>
    <!-- The replica client fills the store it is given; keeping it is the point -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="dev.heysulo.archon.sdk.config.ConfigReplicaClient"/>
        <Method name="&lt;init&gt;"/>
    </Match>
</FindBugsFilter>
