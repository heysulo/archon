<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Returning the shared instance is the purpose of a singleton accessor. -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Method name="getInstance"/>
    </Match>
    <!-- Known design debt: a termination from the registry ends the host process. Replacing this with a callback
         changes SDK behaviour, so it needs a deliberate decision. -->
    <Match>
        <Bug pattern="DM_EXIT"/>
        <Class name="dev.heysulo.archon.sdk.registry.PrimaryRegistry"/>
        <Method name="onMessage"/>
    </Match>
    <!-- A primary that loses the vote against another primary must stop so only one keeps serving. Its
         orchestrator restarts it, and it rejoins as a mirror. -->
    <Match>
        <Bug pattern="DM_EXIT"/>
        <Class name="dev.heysulo.archon.registry.server.RegistryTermination"/>
    </Match>
</FindBugsFilter>
