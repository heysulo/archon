<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Returning the shared instance is the purpose of a singleton accessor. -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Method name="getInstance"/>
    </Match>
    <!-- The default reaction to a termination from the registry ends the host process, so its orchestrator starts
         a fresh instance. Applications can override ArchonCallback.onTerminated to do otherwise. -->
    <Match>
        <Bug pattern="DM_EXIT"/>
        <Class name="dev.heysulo.archon.sdk.ArchonTermination"/>
    </Match>
    <!-- A primary that loses the vote against another primary must stop so only one keeps serving. Its
         orchestrator restarts it, and it rejoins as a mirror. -->
    <Match>
        <Bug pattern="DM_EXIT"/>
        <Class name="dev.heysulo.archon.registry.server.RegistryTermination"/>
    </Match>
    <!-- A portal replica that cannot register exits so its orchestrator starts a fresh one to retry. -->
    <Match>
        <Bug pattern="DM_EXIT"/>
        <Class name="dev.heysulo.archon.portal.PortalApplication"/>
        <Method name="register"/>
    </Match>
</FindBugsFilter>
